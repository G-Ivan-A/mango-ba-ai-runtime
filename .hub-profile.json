{
  "profile_version": "0.4",
  "package": "execution-package-mvp-bcreq",
  "meta_model_version": "0.4",
  "entrypoint": "AGENTS.md",
  "route": "routes/rg-bcreq-v1.yaml",
  "skills_path": ".agents/skills",
  "skills": [
    "transcript-normalization-contact-center",
    "context-extraction-contact-center",
    "ambiguity-detection-contact-center",
    "core-assembly-contact-center",
    "question-formation-contact-center",
    "question-prioritization-contact-center",
    "answer-integration-contact-center",
    "problem-statement-contact-center",
    "value-hypothesis-contact-center",
