      "external_systems": {"tier": "ST-4-EXTERNAL", "status": "out_of_slice", "reason": "systems and access policy are not supplied"},
      "local_repository_fallback": {"tier": "ST-5-LOCAL", "status": "available", "path": "docs/kb"}
    }
  },
  "validation": {"command": "sh tools/validate-package.sh", "python_required": false}
}
